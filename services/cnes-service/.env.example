# Servidor
NODE_ENV=development
PORT=3002
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Banco (ver infrastructure/docker-compose.yml)
DATABASE_URL=postgres://smarthealth:smarthealth@localhost:5432/smarthealth

# API de dados abertos do Ministério da Saúde (sem /v1)
CNES_API_BASE_URL=https://apidadosabertos.saude.gov.br
# Código IBGE de 6 dígitos (Teresina = 221100)
CNES_CODIGO_MUNICIPIO=221100
# Pausa entre requisições, timeout por requisição e número de tentativas
CNES_REQUEST_DELAY_MS=150
CNES_REQUEST_TIMEOUT_MS=15000
CNES_MAX_RETRIES=3

# Sync automático (expressão cron do node-cron; padrão: segunda às 03:00)
SYNC_CRON_ENABLED=true
SYNC_CRON=0 3 * * 1
SYNC_TIMEZONE=America/Fortaleza
